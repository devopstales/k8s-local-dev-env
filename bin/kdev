#!/usr/bin/env python3

import argparse

from functions.helepers import manage_cert

from functions.docker import \
    create_docker_network, delete_docker_network

from functions.minikube import \
    start_minikube, stop_minikube,\
    delete_minikube, pause_minikube, load_docker_image, \
    start_registry, stop_registry

from functions.cni import start_cni_network

from functions.apps import deploy_crds, \
    deploy_prometheus, \
    create_sso_server, \
    create_kubedash_server, remove_kubedash_server

from functions.dns import \
    create_dns_server

from functions.ingress import \
    install_ingress, remove_ingress, \
    install_cert_manager, remove_cert_manager
    
#############################################################################
# Variables
#############################################################################

from functions.helepers import CONFIG_JSON

if CONFIG_JSON['network']['driver'] == "cilium":
    if CONFIG_JSON['network']['loadbalancer'] == "cilium":
        CNI_DRIVER = "false"
    else:
        CNI_DRIVER = "cilium"
elif CONFIG_JSON['network']['driver'] == "cilium-helm":
        CNI_DRIVER = "false"
elif CONFIG_JSON['network']['driver'] == "calico":
        CNI_DRIVER = "calico"
elif CONFIG_JSON['network']['driver'] == "flannel":
        CNI_DRIVER = "flannel"
elif CONFIG_JSON['network']['driver'] == "kindnet":
        CNI_DRIVER = "kindnet"
elif CONFIG_JSON['network']['driver'] == "bridge":
        CNI_DRIVER = "bridge"
else:
        CNI_DRIVER = "flannel"

#############################################################################
# Main functions
#############################################################################

def up_functions():
    manage_cert()
    create_docker_network()
    start_minikube(CNI_DRIVER)
    start_cni_network(CNI_DRIVER) # loadbalancer, frr-config
    deploy_crds() # anmespaces, crds for: prometheus, gatewayApi, cert-manager, etc


def delete_functions():
    delete_minikube()
    delete_docker_network()
    
def stop_functions():
    stop_minikube()

def pause_functions():
    pause_minikube()
    
def enable_function(addon):
    if addon == "all":
        install_cert_manager()
        install_ingress()
        if CONFIG_JSON['sso']['enabled'] == 'true':
            create_sso_server()
        if CONFIG_JSON['network']['local_dns_server'] == "true":
            create_dns_server()

    elif addon == 'network':
        start_cni_network(CNI_DRIVER)

    elif addon == "dns":
        if CONFIG_JSON['network']['local_dns_server'] == "true":
                create_dns_server()

    elif addon == "cert-manager":
        install_cert_manager()

    elif addon == "ingress":
        install_ingress()

    elif addon == "sso":
        if CONFIG_JSON['sso']['enabled'] == 'true':
            create_sso_server()
        else:
            print(f"SSO in not enable in config")

    elif addon == "kubedash":
        if CONFIG_JSON['sso']['enabled'] == 'true':
            create_sso_server()
            create_kubedash_server()
        else:
            print(f"SSO in not enable in config")
            
    elif addon == "registry":
        if CONFIG_JSON['network']['driver'] == "cilium-helm":
            if CONFIG_JSON['network']['loadbalancer'] == "cilium":
                start_registry()
            else:
                print(f"Loadbalancer in not enable in config")
        else:
            print(f"Loadbalancer type cilium is only available in cilium-helm cni type")
            
    else:
        print("Addon : %s is invalid" % addon)
        
def disable_function(addon):
    if addon == "cert-manager":
        remove_cert_manager()
        
    if addon == "kubedash":
        remove_kubedash_server()

#############################################################################
# argparser
#############################################################################

parser = argparse.ArgumentParser()
parser.add_argument("--up", nargs='?', default=False, help="Create a new Kubernetes environment")
parser.add_argument("--down", action="store_true", default=False, help="Stop a Kubernetes environment")
parser.add_argument("--stop", action="store_true", default=False, help="Stop a Kubernetes environment")
parser.add_argument("--destroy", action="store_true", default=False, help="Destroy a Kubernetes environment")
parser.add_argument("--pause", action="store_true", default=False, help="Pause a Kubernetes pods")

parser.add_argument("--enable", action="store", default=False, help="Enable Kubernetes addon")
parser.add_argument("--disable", action="store", default=False, help="Disable Kubernetes Addon")

parser.add_argument("--load-image", nargs=1, default=False, help="Load local docker image to kind cluster")

args = parser.parse_args()
        
if args.up or args.up == None:
    if args.up == "all":
        up_functions()
        enable_function(args.up)
        #print_messages(args.up)
    else:
        up_functions()
        #print_messages("base")

if args.down:
    stop_functions()
    
if args.stop:
    stop_functions()
    
if args.destroy:
    delete_functions()
    
if args.pause:
    pause_minikube()
    
if args.enable:
    enable_function(args.enable)
    
if args.load_image:
    load_docker_image(args.load_image[0])